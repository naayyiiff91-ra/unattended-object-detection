# SentinAI Environment Configuration
# Copy this file to .env and fill in your Gemini API key:
# copy .env.example .env

# Google Gemini API Key (Required for Gemma 4 multimodal alert generation)
# Obtain a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Video Source (0 for default webcam, or path to video file e.g. test.mp4)
CAMERA_SOURCE=0

# Unattended separation threshold in seconds (15 for testing, 300 for production)
ALERT_THRESHOLD=15

# Pixel proximity threshold for attended state
PROXIMITY_THRESHOLD=150

# Web Dashboard Port
PORT=5000

